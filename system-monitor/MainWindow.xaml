<Window x:Class="SystemMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SystemMonitor.Controls"
        Title="System Monitor" Width="900" Height="600" MinWidth="700" MinHeight="480"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
      <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBlock Text="SYSTEM MONITOR" FontSize="13" FontWeight="SemiBold"/>
      <TextBlock x:Name="UpdatedLabel" Text="Connecting…" Foreground="{StaticResource MutedBrush}" Margin="18,1,0,0"/>
    </StackPanel>
    <UniformGrid Grid.Row="1" Columns="3" Rows="1" VerticalAlignment="Stretch">
      <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="22" Margin="0,0,12,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="PROCESSOR" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,8"><TextBlock x:Name="CpuValue" Text="--" FontSize="42" FontWeight="SemiBold"/><TextBlock Text="%" FontSize="18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,7"/></StackPanel>
          <controls:Sparkline x:Name="CpuChart" Grid.Row="2" Height="120" VerticalAlignment="Center"/>
          <ProgressBar x:Name="CpuBar" Grid.Row="3" Height="5" Maximum="100" IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="22" Margin="6,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="MEMORY" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,8"><TextBlock x:Name="MemoryValue" Text="--" FontSize="42" FontWeight="SemiBold"/><TextBlock Text="%" FontSize="18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,7"/></StackPanel>
          <controls:Sparkline x:Name="MemoryChart" Grid.Row="2" Height="120" VerticalAlignment="Center" LineBrush="#8EA6FF"/>
          <StackPanel Grid.Row="3"><ProgressBar x:Name="MemoryBar" Height="5" Maximum="100" IsHitTestVisible="False"/><TextBlock x:Name="MemoryDetail" Text="-- / -- GB" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/></StackPanel>
        </Grid>
      </Border>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="22" Margin="12,0,0,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="TEMPERATURE" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,8"><TextBlock x:Name="TemperatureValue" Text="--" FontSize="42" FontWeight="SemiBold"/><TextBlock Text="°C" FontSize="18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,7"/></StackPanel>
          <TextBlock x:Name="TemperatureNote" Grid.Row="2" Text="Waiting for sensor data" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="3" Text="Hottest available sensor" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        </Grid>
      </Border>
    </UniformGrid>
    <TextBlock Grid.Row="2" Text="Live readings · 1 second interval · history window 60 seconds" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,22,0,0"/>
  </Grid>
</Window>
