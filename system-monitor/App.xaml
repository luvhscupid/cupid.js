<Application x:Class="SystemMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B1020" />
    <SolidColorBrush x:Key="PanelBrush" Color="#141B2D" />
    <SolidColorBrush x:Key="MutedBrush" Color="#95A1B8" />
    <SolidColorBrush x:Key="TextBrush" Color="#F4F7FC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#66E3C4" />
  </Application.Resources>
</Application>
